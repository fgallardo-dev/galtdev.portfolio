---
import { useTranslations } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative text-center pt-4 pb-12 px-6">

  <!-- Etiquetas de rol y año: texto independiente, cada una es un párrafo -->
  <p class="absolute left-6 top-2 font-mono text-xs tracking-widest text-brand-mid">
    {t.hero.role}
  </p>
  <p class="absolute right-6 top-2 font-mono text-xs tracking-widest text-brand-mid">
    {t.hero.year}
  </p>

  <!-- Cubos flotantes: lista de tecnologías, decorativa para lectores de pantalla -->
  <ul aria-hidden="true">
    <li class="cube cube--ts font-mono font-bold text-lg text-accent">TS</li>
    <li class="cube cube--md cube--py font-mono font-bold text-xl text-teal">PY</li>
    <li class="cube cube--sm cube--js font-mono font-bold text-base text-teal-dark">JS</li>
  </ul>

  <!-- Cabecera de la sección: tagline + título -->
  <header>
    <p class="font-mono text-xs tracking-widest text-accent mt-5 mb-2">
      {t.hero.tagline}
    </p>

    <div class="relative inline-block">
      <h1 class="hero-title font-display font-medium leading-none tracking-wide">
        PORTFOLIO
      </h1>
      <svg
        class="star absolute -top-1 -right-7 text-accent"
        width="24" height="24"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 0c.6 6.4 5 10.8 12 11.4C17 12 12.6 16.4 12 24c-.6-7.6-5-12-12-12.6C7 11 11.4 6.6 12 0z" />
      </svg>
    </div>
  </header>

  <!-- Escenario: koala + pedestal escalan juntos dentro de este contenedor -->
  <div class="stage flex flex-col items-center mx-auto">
    <img
      src="/kobi.png"
      alt="Kobi el koala"
      class="koala"
    />
    <p class="pedestal flex items-center justify-center font-mono font-bold text-xs tracking-widest text-brand-dark">
      {t.hero.welcome}
    </p>
  </div>

</section>

<style>
  .hero-title {
    /* Fluido: 106px en escritorio, se reduce solo cuando el ancho no alcanza */
    font-size: clamp(44px, 11vw, 106px);
    background: linear-gradient(176deg, #8B5E34 0%, #D9722C 46%, #e7caa6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .star {
    animation: pulse 3.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50%       { transform: scale(1.35); opacity: 1; }
  }

  .cube {
    position: absolute;
    width: clamp(46px, 4.2vw, 62px);
    aspect-ratio: 1;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 10px 24px rgba(92, 63, 33, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(var(--r, 0));
    animation: float 5.5s ease-in-out infinite;
  }

  .cube--md { width: clamp(52px, 4.8vw, 70px); border-radius: 18px; }
  .cube--sm { width: clamp(40px, 3.6vw, 54px); border-radius: 14px; }

  /* Posiciones en % — escalan con la pantalla en vez de quedar clavadas en px */
  .cube--ts { --r: -12deg; left: 22%; top: 22%; }
  .cube--py { --r: 14deg; right: 22%; top: 17%; animation-duration: 6.5s; animation-delay: 0.6s; }
  .cube--js { --r: -8deg; right: 15%; top: 33%; animation-duration: 5s; animation-delay: 0.3s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(var(--r, 0)); }
    50%       { transform: translateY(-12px) rotate(var(--r, 0)); }
  }

  /* El escenario es la única referencia de tamaño: koala y pedestal miden contra él */
  .stage {
    width: min(1000px, 92vw);
  }

  .koala {
    width: 68%;
    filter: drop-shadow(0 10px 14px rgba(92, 63, 33, 0.13));
    margin-bottom: -4%;
  }

  .pedestal {
    width: 100%;
    height: clamp(40px, 6vw, 60px);
    background: linear-gradient(180deg, #EBD6C1, #e2c6a6);
    border-radius: 46px 46px 0 0;
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.55);
  }

  /* Móvil: cubos a los bordes para no pisar el título, el más chico se oculta */
  @media (max-width: 640px) {
    .cube--ts { left: 4%; top: 9%; }
    .cube--py { right: 5%; top: 7%; }
    .cube--js { display: none; }
  }
</style>
