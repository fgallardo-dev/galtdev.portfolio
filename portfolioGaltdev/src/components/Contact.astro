---
import { useTranslations } from '../i18n/translations';
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// El email vive en .env (fuera del repo) y se inyecta al construir.
// Sin la variable, el build falla a propósito: mejor que publicar botones rotos.
const email = import.meta.env.CONTACT_EMAIL as string | undefined;
if (!email) {
  throw new Error(
    'CONTACT_EMAIL is not set. Create portfolioGaltdev/.env from .env.example.'
  );
}
const LINKEDIN_URL = 'https://www.linkedin.com/in/gallardotech';

const mailto = (subject: string) =>
  `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<section class="px-6 py-16">

  <header class="text-center mb-12">
    <h1 class="font-display text-4xl md:text-5xl font-medium">
      {t.contact.title}
    </h1>
    <p class="mt-3 text-brand-mid">
      {t.contact.subtitle}
    </p>
  </header>

  <!-- Cada card es una puerta de entrada con su asunto prellenado -->
  <ul class="cards mx-auto grid gap-5 md:grid-cols-2">
    {t.contact.sections.map((s) => (
      <li id={s.id} class="card">
        <span class="text-3xl" aria-hidden="true">{s.emoji}</span>
        <h2 class="font-sans font-bold text-lg text-brand-dark">{s.title}</h2>
        <p class="text-sm text-brand-mid">{s.text}</p>
        <div class="flex flex-wrap items-center gap-3 mt-auto pt-2">
          <a href={mailto(s.subject)} class="cta font-sans">{s.cta}</a>
          {s.id === 'work' && (
            <a
              href={LINKEDIN_URL}
              class="linkedin font-mono text-xs"
              target="_blank"
              rel="noopener noreferrer"
            >LinkedIn <span aria-hidden="true">↗</span></a>
          )}
        </div>
      </li>
    ))}
  </ul>

</section>

<style>
  .cards {
    max-width: 900px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(92, 63, 33, 0.08);
    box-shadow: 0 10px 24px rgba(92, 63, 33, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    /* Al llegar por ancla (#botiquin), que el título no quede pegado al borde */
    scroll-margin-top: 90px;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(92, 63, 33, 0.14);
  }

  .cta {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--color-brand-dark);
    color: var(--color-brand-light);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: box-shadow 0.15s ease;
  }

  .cta:hover {
    box-shadow: 0 8px 20px rgba(92, 63, 33, 0.25);
  }

  .linkedin {
    padding: 9px 14px;
    border-radius: 999px;
    border: 1.5px solid rgba(92, 63, 33, 0.22);
    color: var(--color-brand-dark);
    text-decoration: none;
  }

  .linkedin:hover {
    background: rgba(92, 63, 33, 0.08);
  }
</style>
